services:
  lldap:
    image: lldap/lldap:stable
    container_name: lldap
    restart: unless-stopped
    ports:
      - "1717:17170"
      - "3890:3890"
    environment:
      - LLDAP_JWT_SECRET=super_secret_jwt_key_bootcamp_2026
      - LLDAP_LDAP_BASE_DN=dc=bootcamp,dc=local
      - LLDAP_LDAP_USER_PASS=adminpassword123
    volumes:
      - lldap_data:/data

  authelia:
    image: authelia/authelia:latest
    container_name: authelia
    restart: unless-stopped
    ports:
      - "9091:9091"
    environment:
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=super_secret_jwt_authelia_2026
      - AUTHELIA_SESSION_SECRET=secret_session_authelia_bootcamp_2026_very_long
      - AUTHELIA_STORAGE_ENCRYPTION_KEY=super_secret_storage_encryption_key_2026
    volumes:
      - ./authelia.yml:/config/configuration.yml:ro
      - authelia_data:/config
    depends_on:
      - lldap

volumes:
  lldap_data:
  authelia_data: